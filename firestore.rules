rules_version = '2';

// KangBudget is a single-user app with no login UI. Every install signs in anonymously
// (see MainActivity.kt) purely so requests carry a Firebase Auth token. There is no
// per-owner uid scoping in the data model, so the bar here is simply "authenticated
// client" vs. "anyone on the internet with the API key", not user A vs. user B.
service cloud.firestore {
  match /databases/{database}/documents {

    match /budgets/{monthId} {
      allow read, write: if request.auth != null;

      match /categories/{categoryId} {
        allow read, write: if request.auth != null;

        match /transactions/{transactionId} {
          allow read, write: if request.auth != null;
        }
      }
    }

    // Holds the Sheets webhook URL + shared secret. The app reads it at startup but never
    // writes it — update it from the Firebase Console (Firestore Data tab) or Admin SDK only.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Offline outbox queue for webhook ops (BudgetRepository.dispatchWebhook/flushOutbox).
    match /webhookOutbox/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
